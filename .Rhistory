# Function to read quant.sf file and return dataframe with gene/transcript column as rownames
read_quant_sf <- function(file) {
df <- read.table(file, header = TRUE)
df <- df[df$NumReads > 0,]
df <-  df %>%
select(Name, NumReads) %>%
rename(NumReads = basename(dirname(file))) # Name the column based on the subdirectory name
return(df)
}
